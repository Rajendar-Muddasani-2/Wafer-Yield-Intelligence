# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ====================
# DATABASE CONFIGURATION
# ====================
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_TNS=your_database_host.example.com
DB_PORT=1521
DB_SERVICE_NAME=your_service_name

# ====================
# DATA PATHS
# ====================
# Network share path for input test data
INPUT_DATA_PATH=//your-server/path/to/data

# Oracle client library path
ORACLE_CLIENT_PATH=./oracle_client_lib

# Local data directories
DATA_DIR=./data
MODELS_DIR=./models
OUTPUT_DIR=./data/output

# ====================
# MODEL CONFIGURATION
# ====================
# Default model to use for retest prediction
DEFAULT_RETEST_MODEL=VC
# Default pattern recognition model
DEFAULT_PATTERN_MODEL=VE

# Model version/product identifiers
PRODUCT_TYPE=M4289B00012
TP_VERSION=P20

# ====================
# PROCESSING CONFIGURATION
# ====================
# Product family identifier
PRODUCT_FAMILY=A1G

# Batch processing settings
BATCH_SIZE=1000
MAX_WORKERS=4

# ====================
# LOGGING
# ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/wafer_yield_intelligence.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ====================
# FEATURE FLAGS
# ====================
ENABLE_PATTERN_RECOGNITION=true
ENABLE_RETEST_PREDICTION=true
ENABLE_ROOT_CAUSE_ANALYSIS=true

# ====================
# PERFORMANCE TUNING
# ====================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
CACHE_ENABLED=true
CACHE_TTL=3600

# ====================
# NOTIFICATION (Optional)
# ====================
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_FROM=noreply@example.com
EMAIL_TO=your.email@example.com

# ====================
# DEVELOPMENT/DEBUG
# ====================
DEBUG_MODE=false
PROFILE_PERFORMANCE=false
SAVE_INTERMEDIATE_FILES=false
